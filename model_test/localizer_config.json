{
  "paths": {
    "data_root": "../dataset",
    "output_dir": "outputs/refined_events"
  },
  "audio": {
    "frame_seconds": 0.025,
    "hop_seconds": 0.005,
    "search_padding_seconds": 0.08,
    "minimum_peak_distance_seconds": 0.03
  },
  "weak_labels": {
    "positive_radius_seconds": 0.01,
    "negative_exclusion_seconds": 0.06,
    "negatives_per_sample": 5,
    "random_seed": 42
  },
  "random_forest": {
    "n_estimators": 400,
    "max_depth": 12,
    "min_samples_leaf": 3,
    "max_features": "sqrt"
  },
  "selection": {
    "random_forest_weight": 0.75,
    "minimum_confidence_for_beats": 0.6,
    "review_if_shift_from_raw_midpoint_seconds": 0.2
  }
}
